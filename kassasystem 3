string enhet1 = "Laptopsal 1";
string id1 = "D-100";
string status1 = "Aktiv";
int price1 = 250;

string enhet2 = "Projektor 1";
string id2 = "D-200";
string status2 = "Service";
int price2 = 450;

string enhet3 = "Skrivare 1";
string id3 = "D-300";
string status3 = "Inaktiv";
int price3 = 300;

string enhet4 = "Tangentbord 1";
string id4 = "D-400";
string status4 = "Aktiv";
int price4 = 350;

double moms = 0.25;

string[] id = { id1, id2, id3, id4 };
string[] namn = { enhet1, enhet2, enhet3, enhet4 };
string[] status = { status1, status2, status3, status4 };
int[] priser = { price1, price2, price3, price4 };
string[] typer = { "Dator", "Projektor", "Skärm", "Övrigt" }; // byt ut mot dina egna fyra typer

Console.WriteLine("=== Enhetsregister ===");

for (int i = 0; i < namn.Length; i++)
{
    // Metoderna returnerar värden som vi sparar i variabler
    string typInformation = HamtaTypInformation(typer[i]);
    string statusInformation = HamtaStatusInformation(status[i]);
    string prisniva = HamtaPrisniva(priser[i]);
    string bedomning = HamtaBedomning(typer[i], status[i], priser[i]);
    string enkelRisk = HamtaEnkelRisk(status[i], priser[i]);
    int riskPoang = BeraknaRiskPoang(typer[i], status[i], priser[i]);
    string riskNiva = HamtaRiskNiva(riskPoang);
    double prisMedMoms = BeraknaPrisMedMoms(priser[i], moms);

    // Metoden skriver bara ut, den returnerar inget (void)
    VisaEnhet(id[i], namn[i], typer[i], typInformation, status[i], statusInformation,
              priser[i], prisniva, prisMedMoms, bedomning, enkelRisk, riskPoang, riskNiva);
}

// ================= METODER =================

static string HamtaTypInformation(string typ)
{
    switch (typ.ToLower())
    {
        case "dator":
            return "Utrustning för datorarbete.";
        case "projektor":
            return "Utrustning för presentation.";
        case "skärm":
            return "Bildskärmsutrustning.";
        case "övrigt":
            return "Annan registrerad utrustning.";
        default:
            return "Okänd typ.";
    }
}

static string HamtaStatusInformation(string status)
{
    switch (status.ToLower())
    {
        case "aktiv":
            return "Enheten är i drift.";
        case "service":
            return "Enheten behöver kontrolleras.";
        case "inaktiv":
            return "Enheten används inte.";
        default:
            return "Okänd status.";
    }
}

static string HamtaPrisniva(int pris)
{
    if (pris > 700)
    {
        return "Hög kostnad";
    }
    else if (pris >= 300)
    {
        return "Normal kostnad";
    }
    else
    {
        return "Låg kostnad";
    }
}

static double BeraknaPrisMedMoms(int pris, double moms)
{
    return pris * (1 + moms);
}

static string HamtaBedomning(string typ, string status, int pris)
{
    string statusLower = status.ToLower();
    bool arAktiv = statusLower == "aktiv";
    bool arService = statusLower == "service";
    bool arInaktiv = statusLower == "inaktiv";
    bool arOvrigt = typ.ToLower() == "övrigt";

    if (arService)
    {
        return "Servicebehov";
    }
    else if (arAktiv && pris > 700)
    {
        return "Prioriterad";
    }
    else if (arInaktiv || arOvrigt)
    {
        return "Kontroll krävs";
    }
    else
    {
        return "Normal";
    }
}

static string HamtaEnkelRisk(string status, int pris)
{
    string statusLower = status.ToLower();
    bool arService = statusLower == "service";
    bool arInaktiv = statusLower == "inaktiv";

    if (arService && pris > 700)
    {
        return "Hög";
    }
    else if (arService || arInaktiv)
    {
        return "Medel";
    }
    else
    {
        return "Låg";
    }
}

static int BeraknaRiskPoang(string typ, string status, int pris)
{
    string typLower = typ.ToLower();
    string statusLower = status.ToLower();
    int poang = 0;

    if (statusLower == "service") poang += 3;
    if (statusLower == "inaktiv") poang += 2;
    if (pris > 700) poang += 2;
    if (typLower == "övrigt") poang += 1;
    if (typLower == "projektor" && pris > 900) poang += 2;

    return poang;
}

static string HamtaRiskNiva(int poang)
{
    if (poang >= 9)
    {
        return "Kritisk";
    }
    else if (poang >= 6)
    {
        return "Hög";
    }
    else if (poang >= 3)
    {
        return "Medel";
    }
    else
    {
        return "Låg";
    }
}

static void VisaEnhet(string id, string namn, string typ, string typInfo,
                      string status, string statusInfo, int pris, string prisniva,
                      double prisMedMoms, string bedomning, string enkelRisk,
                      int riskPoang, string riskNiva)
{
    Console.WriteLine();
    Console.WriteLine("================================");
    Console.WriteLine($"ID: {id}");
    Console.WriteLine($"Namn: {namn}");
    Console.WriteLine($"Typ: {typ} ({typInfo})");
    Console.WriteLine($"Status: {status} ({statusInfo})");
    Console.WriteLine($"Pris: {pris} kr ({prisniva})");
    Console.WriteLine($"Pris inklusive moms: {prisMedMoms} kr");
    Console.WriteLine($"Bedömning: {bedomning}");
    Console.WriteLine($"Enkel risknivå: {enkelRisk}");
    Console.WriteLine($"Riskpoäng: {riskPoang} -> {riskNiva}");