// ===================== DEL 5: NYA METODER I PROGRAM =====================

// Samlar ihop all information om en enhet och returnerar färdig text
static string BeskrivEnhet(string id, string namn, string typ, string status, decimal pris)
{
    string typInformation = HamtaTypInformation(typ);
    string statusInformation = HamtaStatusInformation(status);
    string prisniva = HamtaPrisniva(pris);
    string bedomning = HamtaBedomning(typ, status, pris);
    string enkelRisk = HamtaEnkelRisk(status, pris);
    int riskPoang = BeraknaRiskPoang(typ, status, pris);
    string riskNiva = HamtaRiskNiva(riskPoang);
    decimal prisMedMoms = Prisberakningar.BeraknaPrisMedMoms(pris);

    return UI.SkapaEnhetstext(id, namn, typ, typInformation, status, statusInformation,
        pris, prisniva, prisMedMoms, bedomning, enkelRisk, riskPoang, riskNiva);
}

// Undermeny för förhandsvisning. Tar emot priset som parameter och ändrar inget.
static void KorPrisforhandsvisning(decimal pris)
{
    bool tillbaka = false;
    while (!tillbaka)
    {
        Console.WriteLine();
        Console.WriteLine(UI.SkapaMenytext("--- Förhandsvisning ---", "Ange rabatt", "Visa originalpris", "Tillbaka"));
        int val = UI.LasaHeltal("Val: ", 1, 3);

        if (val == 1)
        {
            decimal rabattProcent = UI.LasaRabattProcent();
            decimal rabatteratPris = Prisberakningar.BeraknaRabatteratPris(pris, rabattProcent);
            decimal momsbelopp = Prisberakningar.BeraknaMomsbelopp(rabatteratPris);
            decimal totalpris = Prisberakningar.BeraknaPrisMedMoms(rabatteratPris);

            UI.VisaPrisforhandsvisning(pris, rabattProcent, rabatteratPris, momsbelopp, totalpris);
        }
        else if (val == 2)
        {
            Console.WriteLine($"Originalpris: {pris:F2} kr exkl. moms");
        }
        else
        {
            tillbaka = true;
        }
    }
}

// Gör om menyvalet till en statustext
static string HamtaNyStatus(int val)
{
    switch (val)
    {
        case 1:
            return "Aktiv";
        case 2:
            return "Inaktiv";
        default:
            return "Service";
    }
}


// ===================== DEL 6: KLASSEN UI (NYTT) =====================
// Allt som handlar om användaren: menyer, inmatning och utskrift.

public static class UI
{
    // ---------- Menytext (returnerar text, skriver inte ut) ----------

    public static string SkapaMenytext(string rubrik, string alternativ1, string alternativ2, string alternativ3)
    {
        return SkapaMenytext(rubrik, new string[] { alternativ1, alternativ2, alternativ3 });
    }

    public static string SkapaMenytext(string rubrik, string[] alternativ)
    {
        string text = rubrik;
        for (int i = 0; i < alternativ.Length; i++)
        {
            text += Environment.NewLine + (i + 1) + ". " + alternativ[i];
        }
        return text;
    }

    public static string SkapaHuvudmeny()
    {
        return SkapaMenytext("=== Huvudmeny ===",
            new string[] { "Visa enhet", "Ändra pris", "Förhandsvisa rabatt", "Ändra status", "Avsluta" });
    }

    public static string SkapaStatusmeny()
    {
        return SkapaMenytext("Välj ny status:",
            new string[] { "Aktiv", "Inaktiv", "Service", "Avbryt" });
    }

    // ---------- Inmatning ----------

    // Läser ett heltal mellan min och max (inklusive) och frågar om tills det är giltigt
    public static int LasaHeltal(string fraga, int min, int max)
    {
        while (true)
        {
            Console.Write(fraga);
            string? input = Console.ReadLine();

            if (int.TryParse(input, out int tal) && tal >= min && tal <= max)
            {
                return tal;
            }

            Console.WriteLine($"Ogiltigt val. Ange ett heltal mellan {min} och {max}.");
        }
    }

    // Pris: noll eller större, aldrig negativt
    public static decimal LasaPris(string fraga)
    {
        while (true)
        {
            Console.Write(fraga);
            string? input = Console.ReadLine();

            if (decimal.TryParse(input, out decimal pris) && pris >= 0)
            {
                return pris;
            }

            Console.WriteLine("Ogiltigt pris. Ange ett tal som är minst 0.");
        }
    }

    // Rabatt: 0-100 inklusive gränserna
    public static decimal LasaRabattProcent()
    {
        while (true)
        {
            Console.Write("Ange rabatt i procent (0-100): ");
            string? input = Console.ReadLine();

            if (decimal.TryParse(input, out decimal rabatt) && rabatt >= 0 && rabatt <= 100)
            {
                return rabatt;
            }

            Console.WriteLine("Ogiltig rabatt. Ange ett tal mellan 0 och 100.");
        }
    }

    // Låter användaren välja enhet, returnerar index (0-baserat)
    public static int ValjEnhet(string[] namn)
    {
        Console.WriteLine("Välj enhet att arbeta med:");
        for (int i = 0; i < namn.Length; i++)
        {
            Console.WriteLine($"{i + 1}. {namn[i]}");
        }
        return LasaHeltal("Val: ", 1, namn.Length) - 1;
    }

    // ---------- Presentation ----------

    // Sammanställd text om enheten (återanvänds vid visning och bekräftelse)
    public static string SkapaEnhetstext(string id, string namn, string typ, string typInfo,
        string status, string statusInfo, decimal pris, string prisniva,
        decimal prisMedMoms, string bedomning, string enkelRisk,
        int riskPoang, string riskNiva)
    {
        string nl = Environment.NewLine;
        return "================================" + nl +
               $"ID: {id}" + nl +
               $"Namn: {namn}" + nl +
               $"Typ: {typ} ({typInfo})" + nl +
               $"Status: {status} ({statusInfo})" + nl +
               $"Pris: {pris:F2} kr ({prisniva})" + nl +
               $"Pris inklusive moms: {prisMedMoms:F2} kr" + nl +
               $"Bedömning: {bedomning}" + nl +
               $"Enkel risknivå: {enkelRisk}" + nl +
               $"Riskpoäng: {riskPoang} -> {riskNiva}";
    }

    // Tar emot färdiga beräkningsresultat, räknar inget själv
    public static void VisaPrisforhandsvisning(decimal originalpris, decimal rabattProcent,
        decimal rabatteratPris, decimal momsbelopp, decimal totalpris)
    {
        Console.WriteLine();
        Console.WriteLine("--- Prisförhandsvisning ---");
        Console.WriteLine($"Originalpris:                 {originalpris:F2} kr");
        Console.WriteLine($"Rabatt:                       {rabattProcent:F2} %");
        Console.WriteLine($"Pris efter rabatt exkl. moms: {rabatteratPris:F2} kr");
        Console.WriteLine($"Momsbelopp:                   {momsbelopp:F2} kr");
        Console.WriteLine($"Totalpris inkl. moms:         {totalpris:F2} kr");
    }
}


// ===================== DEL 7: KLASSEN Prisberakningar (NYTT) =====================
// Bara beräkningar. Läser aldrig från och skriver aldrig till konsolen.

public static class Prisberakningar
{
    // Momsregeln finns bara på ett ställe
    private const decimal MomsSats = 0.25m;

    // Pris efter rabatt, exklusive moms
    public static decimal BeraknaRabatteratPris(decimal pris, decimal rabattProcent)
    {
        decimal rabattBelopp = pris * (rabattProcent / 100m);
        return pris - rabattBelopp;
    }

    // Själva momsbeloppet (25 %)
    public static decimal BeraknaMomsbelopp(decimal pris)
    {
        return pris * MomsSats;
    }

    // Pris inklusive moms, återanvänder BeraknaMomsbelopp
    public static decimal BeraknaPrisMedMoms(decimal pris)
    {
        return pris + BeraknaMomsbelopp(pris);
    }
}