// ===================== DEL 4: DINA METODER =====================
// Samma som dina, men pris är decimal istället för int.

static string HamtaTypInformation(string typ)
{
    switch (typ.ToLower())
    {
        case "dator":
            return "Utrustning för datorarbete.";
        case "projektor":
            return "Utrustning för presentation.";
        case "skärm":
            return "Bildskärmsutrustning.";
        case "övrigt":
            return "Annan registrerad utrustning.";
        default:
            return "Okänd typ.";
    }
}

static string HamtaStatusInformation(string status)
{
    switch (status.ToLower())
    {
        case "aktiv":
            return "Enheten är i drift.";
        case "service":
            return "Enheten behöver kontrolleras.";
        case "inaktiv":
            return "Enheten används inte.";
        default:
            return "Okänd status.";
    }
}

static string HamtaPrisniva(decimal pris) // ÄNDRAT: int -> decimal
{
    if (pris > 700)
    {
        return "Hög kostnad";
    }
    else if (pris >= 300)
    {
        return "Normal kostnad";
    }
    else
    {
        return "Låg kostnad";
    }
}

// BORTTAGEN: din BeraknaPrisMedMoms(int pris, double moms).
// Den ersätts av Prisberakningar.BeraknaPrisMedMoms i DEL 7.

static string HamtaBedomning(string typ, string status, decimal pris) // ÄNDRAT: int -> decimal
{
    string statusLower = status.ToLower();
    bool arAktiv = statusLower == "aktiv";
    bool arService = statusLower == "service";
    bool arInaktiv = statusLower == "inaktiv";
    bool arOvrigt = typ.ToLower() == "övrigt";

    if (arService)
    {
        return "Servicebehov";
    }
    else if (arAktiv && pris > 700)
    {
        return "Prioriterad";
    }
    else if (arInaktiv || arOvrigt)
    {
        return "Kontroll krävs";
    }
    else
    {
        return "Normal";
    }
}

static string HamtaEnkelRisk(string status, decimal pris) // ÄNDRAT: int -> decimal
{
    string statusLower = status.ToLower();
    bool arService = statusLower == "service";
    bool arInaktiv = statusLower == "inaktiv";

    if (arService && pris > 700)
    {
        return "Hög";
    }
    else if (arService || arInaktiv)
    {
        return "Medel";
    }
    else
    {
        return "Låg";
    }
}

static int BeraknaRiskPoang(string typ, string status, decimal pris) // ÄNDRAT: int -> decimal
{
    string typLower = typ.ToLower();
    string statusLower = status.ToLower();
    int poang = 0;

    if (statusLower == "service") poang += 3;
    if (statusLower == "inaktiv") poang += 2;
    if (pris > 700) poang += 2;
    if (typLower == "övrigt") poang += 1;
    if (typLower == "projektor" && pris > 900) poang += 2;

    return poang;
}

static string HamtaRiskNiva(int poang)
{
    if (poang >= 9)
    {
        return "Kritisk";
    }
    else if (poang >= 6)
    {
        return "Hög";
    }
    else if (poang >= 3)
    {
        return "Medel";
    }
    else
    {
        return "Låg";
    }
}

// Din VisaEnhet. ÄNDRAT: den skriver nu ut texten från UI.SkapaEnhetstext
