    decimal prisMedMoms, string bedomning, string enkelRisk,
    int riskPoang, string riskNiva)
{
    Console.WriteLine();
    Console.WriteLine(UI.SkapaEnhetstext(id, namn, typ, typInfo, status, statusInfo,
