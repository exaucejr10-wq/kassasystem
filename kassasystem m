string enhet1 = "Laptopsal 1";
string id1 = "D-100";
string status1 = "Aktiv";
int price1 = 250;

string enhet2 = "Projektor 1";
string id2 = "D-200";
string status2 = "Service";
int price2 = 450;

string enhet3 = "Skrivare 1";
string id3 = "D-300";
string status3 = "Inaktiv";
int price3 = 300;

string enhet4 = "Tangentbord 1";
string id4 = "D-400";
string status4 = "Aktiv";
int price4 = 350;

double moms = 0.25;

string[] id = { id1, id2, id3, id4 };
string[] namn = { enhet1, enhet2, enhet3, enhet4 };
string[] status = { status1, status2, status3, status4 };
int[] priser = { price1, price2, price3, price4 };
string[] typer = { "Dator", "Projektor", "Skärm", "Övrigt" }; // byt ut mot dina egna fyra typer

Console.WriteLine("=== Enhetsregister ===");

for (int i = 0; i < namn.Length; i++)
{
string typLower = typer[i].ToLower();
string statusLower = status[i].ToLower();

// ---------- Typinformation ----------
string typInformation;
switch (typLower)
{
case "dator":
typInformation = "Utrustning för datorarbete.";
break;
case "projektor":
typInformation = "Utrustning för presentation.";
break;
case "skärm":
typInformation = "Bildskärmsutrustning.";
break;
case "övrigt":
typInformation = "Annan registrerad utrustning.";
break;
default:
typInformation = "Okänd typ.";
break;
}

// ---------- Statusinformation ----------
string statusInformation;
switch (statusLower)
{
case "aktiv":
statusInformation = "Enheten är i drift.";
break;
case "service":
statusInformation = "Enheten behöver kontrolleras.";
break;
case "inaktiv":
statusInformation = "Enheten används inte.";
break;
default:
statusInformation = "Okänd status.";
break;
}

// ---------- Prisnivå ----------
string prisniva;
if (priser[i] > 700)
{
prisniva = "Hög kostnad";
}
else if (priser[i] >= 300)
{
prisniva = "Normal kostnad";
}
else
{
prisniva = "Låg kostnad";
}

// Hjälpvariabler som gör de långa villkoren lättare att läsa
bool arAktiv = statusLower == "aktiv";
bool arService = statusLower == "service";
bool arInaktiv = statusLower == "inaktiv";
bool arOvrigt = typLower == "övrigt";

// ---------- Bedömning ----------
string bedomning;
if (arService)
{
bedomning = "Servicebehov";
}
else if (arAktiv && priser[i] > 700)
{
bedomning = "Prioriterad";
}
else if (arInaktiv || arOvrigt)
{
bedomning = "Kontroll krävs";
}
else
{
bedomning = "Normal";
}

// ---------- Enkel risknivå ----------
string enkelRisk;
if (arService && priser[i] > 700)
{
enkelRisk = "Hög";
}
else if (arService || arInaktiv)
{
enkelRisk = "Medel";
}
else
{
enkelRisk = "Låg";
}

// ---------- Riskpoäng ----------
int riskPoang = 0;
if (arService) riskPoang += 3;
if (arInaktiv) riskPoang += 2;
if (priser[i] > 700) riskPoang += 2;
if (arOvrigt) riskPoang += 1;
if (typLower == "projektor" && priser[i] > 900) riskPoang += 2;

string riskNivaFranPoang;
if (riskPoang >= 9)
{
riskNivaFranPoang = "Kritisk";
}
else if (riskPoang >= 6)
{
riskNivaFranPoang = "Hög";
}
else if (riskPoang >= 3)
{
riskNivaFranPoang = "Medel";
}
else
{
riskNivaFranPoang = "Låg";
}

// ---------- Slutrapport för enheten ----------
Console.WriteLine();
Console.WriteLine("================================");
Console.WriteLine($"ID: {id[i]}");
Console.WriteLine($"Namn: {namn[i]}");
Console.WriteLine($"Typ: {typer[i]} ({typInformation})");
Console.WriteLine($"Status: {status[i]} ({statusInformation})");
Console.WriteLine($"Pris: {priser[i]} kr ({prisniva})");
Console.WriteLine($"Bedömning: {bedomning}");
Console.WriteLine($"Enkel risknivå: {enkelRisk}");
Console.WriteLine($"Riskpoäng: {riskPoang} -> {riskNivaFranPoang}");
}